# T-Ride staging account provisioning — copy to .env.staging-provision.local
# Never commit .env.staging-provision.local
#
# Use ONE of:
# A) SSH tunnel from your machine to staging tride-db, then point here at localhost + tunnel port
# B) Run provision inside tride-backend on the staging server (DB_HOST=tride-db)

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=tride_staging
DB_USER=tride_app
DB_PASSWORD=replace-with-staging-db-password
