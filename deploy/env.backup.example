# T-Ride staging backup automation configuration (example only).
# Copy to /opt/t-ride/.env.backup on the server.
# Never commit real credentials, access keys, or tokens.

# Remote off-server copy (rclone remote must be configured on the host separately)
TRIDE_BACKUP_REMOTE_ENABLED=0
TRIDE_BACKUP_REMOTE_NAME=
TRIDE_BACKUP_REMOTE_PATH=T-Rider

# Local retention pruning during daily cycle (default OFF)
TRIDE_BACKUP_AUTO_PRUNE=0

# Optional alert hook (fixed script path only; no arbitrary shell commands)
TRIDE_BACKUP_ALERT_ENABLED=0
TRIDE_BACKUP_ALERT_SCRIPT=/opt/t-ride/backend/scripts/staging-db-backup-alert.sh
