[Unit]
Description=T-Ride staging DB monthly restore rehearsal
Documentation=file:/opt/t-ride/docs/BACKUP_RESTORE_RUNBOOK.md
After=docker.service
Wants=docker.service
ConditionPathExists=/opt/t-ride/backend/scripts/run-staging-db-monthly-rehearsal.sh

[Service]
Type=oneshot
WorkingDirectory=/opt/t-ride
EnvironmentFile=-/opt/t-ride/.env.backup
ExecStart=/bin/bash /opt/t-ride/backend/scripts/run-staging-db-monthly-rehearsal.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tride-staging-db-rehearsal

[Install]
WantedBy=multi-user.target
