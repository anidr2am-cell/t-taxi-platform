[Unit]
Description=Daily T-Ride staging DB backup cycle timer
Documentation=file:/opt/t-ride/docs/BACKUP_RESTORE_RUNBOOK.md

[Timer]
# 02:30 Asia/Bangkok — requires systemd with Timezone= support (>= v253).
# On older hosts, use: OnCalendar=*-*-* 02:30:00 and set host timezone to Asia/Bangkok.
OnCalendar=*-*-* 02:30:00
Timezone=Asia/Bangkok
Persistent=true
Unit=tride-staging-db-backup.service

[Install]
WantedBy=timers.target
